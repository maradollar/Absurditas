  },
  {
    "start": 18.74,
    "end": 20.0,
    "text": "GRÜN."
  },
  {
    "start": 21.54,
    "end": 22.66,
    "text": "NICHT LOS."
  },
  {
    "start": 25.32,
    "end": 27.9,
    "text": "GENAU DORT."
  },
  {
    "start": 30.1,
    "end": 31.8,
    "text": "ZUKUNFT GESEHEN."
  },
  {
    "start": 32.38,
