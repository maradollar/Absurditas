    "text": "VERÄNDERT."
  },
  {
    "start": 38.44,
    "end": 40.34,
    "text": "1 MINUTE VORAUS."
  },
  {
    "start": 50.06,
    "end": 53.05,
    "text": "60 SEKUNDEN."
  },
  {
    "start": 57.15,
    "end": 60.2,
    "text": "KEINE GEDANKEN."
  },
  {
    "start": 61.1,
    "end": 63.9,
    "text": "KEIN FERNBLICK."
  },
  {
    "start": 65.48,
    "end": 68.9,
    "text": "KEINE ENDLOSSCHLEIFE."
  },
  {
    "start": 80.0,
    "end": 83.3,
    "text": "DU ENTSCHEIDEST."
  },
  {
    "start": 89.96,
    "end": 91.7,
    "text": "FÜHLT SICH FANTASTISCH AN."
  },
  {
    "start": 106.48,
    "end": 109.0,
    "text": "KEIN KAFFEE AUF DIR."
  },
  {
    "start": 113.7,
    "end": 116.2,
    "text": "REGEN."
  },
  {
    "start": 126.2,
    "end": 129.0,
    "text": "GLÜCK? WISSEN."
  },
  {
    "start": 132.3,
    "end": 134.7,
    "text": "GELD?"
  },
  {
    "start": 148.8,
    "end": 152.1,
    "text": "NÄCHSTE WOCHE? BLEIBT OFFEN."
  },
  {
    "start": 159.14,
    "end": 162.9,
    "text": "IMMER VOM JETZT."
  },
  {
    "start": 169.4,
    "end": 172.1,
    "text": "BEI MENSCHEN WIRD’S KOMPLIZIERT."
  },
  {
    "start": 178.94,
    "end": 181.0,
    "text": "KURZ. KÜHL."
  },
  {
    "start": 187.1,
    "end": 188.8,
    "text": "SCHON BESSER."
  },
  {
    "start": 222.0,
    "end": 224.9,
    "text": "DER MOMENT LEIDET."
  },
  {
    "start": 229.1,
    "end": 232.0,
    "text": "ER GEHT."
  },
  {
    "start": 249.7,
    "end": 253.0,
    "text": "ZUKUNFT VERÄNDERT."
  },
  {
    "start": 259.0,
    "end": 263.3,
    "text": "WANN HILFT DER NÄCHSTE BLICK?"
  },
  {
    "start": 279.34,
    "end": 282.35,
    "text": "1 MINUTE VORAUS."
  },
  {
    "start": 283.0,
    "end": 286.5,
    "text": "DEINE ENTSCHEIDUNG."
  },
  {
    "start": 287.62,
    "end": 292.6,
    "text": "IMMER NUTZEN? GRENZEN SETZEN?"
  },
  {
    "start": 294.14,
    "end": 296.5,
    "text": "SCHREIB’S IN DIE KOMMENTARE."
  },
  {
